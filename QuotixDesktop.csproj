<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Quotix</AssemblyName>
    <Version>1.0.1</Version>
    <!-- 不显式指定 AssemblyVersion / FileVersion，由 SDK 自动从 Version 派生，确保文件版本随发布版本实时更新 -->
    <InformationalVersion>1.0.1</InformationalVersion>
    <Company>Grafdustin</Company>
    <Authors>Grafdustin</Authors>
    <Copyright>Copyright (C) 2026 Grafdustin</Copyright>
    <PackageProjectUrl>https://github.com/Grafdustin/Quotix</PackageProjectUrl>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove=".workbuddy\**\*.cs" />
    <Compile Remove="Updater\**\*.cs" />
    <Page Remove="bin\**\*.xaml" />
    <Page Remove="obj\**\*.xaml" />
    <Page Remove=".workbuddy\**\*.xaml" />
    <Page Remove="Updater\**\*.xaml" />
    <ApplicationDefinition Remove="bin\**\*.xaml" />
    <ApplicationDefinition Remove="obj\**\*.xaml" />
    <ApplicationDefinition Remove=".workbuddy\**\*.xaml" />
    <ApplicationDefinition Remove="Updater\**\*.xaml" />
    <EmbeddedResource Remove="bin\**\*" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove=".workbuddy\**\*" />
    <EmbeddedResource Remove="Updater\**\*" />
    <None Remove="Updater\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\quotation-template.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyUpdaterAfterBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\Updater\Quotix.Updater.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained" />
    <RemoveDir Directories="$(OutDir)Updater" />
    <ItemGroup>
      <UpdaterBuildOutput Include="$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\net48\**\*" Exclude="$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\net48\**\*.pdb;$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\net48\**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterBuildOutput)" DestinationFiles="@(UpdaterBuildOutput-&gt;'$(OutDir)Updater\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>