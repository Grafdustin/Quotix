<Window x:Class="Quotix.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quotix 更新"
        Width="560" Height="340"
        MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#F2F6F8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="5"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="Q" Foreground="White" FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Quotix 更新" Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="30,25,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="正在更新 Quotix"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="请保持程序运行，更新完成后将自动重新打开"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12.5"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="11,5" VerticalAlignment="Top"
                            Background="#E7F2FA" CornerRadius="5">
                        <TextBlock x:Name="VersionText"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Margin="0,22,0,20"
                        Padding="20,18"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Text="正在准备更新"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="DownloadProgress"
                                     Height="7" Margin="0,17,0,11"
                                     Minimum="0" Maximum="100"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#E8EAED">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <Grid x:Name="PART_Track" ClipToBounds="True">
                                            <Border x:Name="PART_Indicator"
                                                    HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="4">
                                                <Border.RenderTransform>
                                                    <TranslateTransform/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsIndeterminate" Value="True">
                                            <Setter TargetName="PART_Indicator" Property="Width" Value="96"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="PART_Indicator"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                            From="-96" To="500"
                                                            Duration="0:0:1.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <Grid>
                            <TextBlock x:Name="SizeText"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"/>
                            <TextBlock x:Name="SpeedText" HorizontalAlignment="Right"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <TextBlock Text="更新过程中请勿关闭程序"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ReturnButton" Content="返回 Quotix"
                                Visibility="Collapsed"
                                Click="ReturnButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="RetryButton" Content="重新尝试"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="Collapsed"
                                Click="RetryButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
