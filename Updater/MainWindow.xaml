<Window x:Class="Quotix.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quotix 更新"
        Width="520" Height="300"
        MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="正在更新 Quotix" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,6,0,0"
                       Foreground="#707070" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="正在准备更新..." FontSize="14"/>
            <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,16,0,10"
                         Minimum="0" Maximum="100"/>
            <Grid>
                <TextBlock x:Name="SizeText" Foreground="#707070" FontSize="12"/>
                <TextBlock x:Name="SpeedText" HorizontalAlignment="Right"
                           Foreground="#707070" FontSize="12"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReturnButton" Content="返回 Quotix" Visibility="Collapsed"
                    Click="ReturnButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="RetryButton" Content="重试" Visibility="Collapsed"
                    Click="RetryButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
